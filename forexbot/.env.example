# ===== MetaTrader 5 =====
MT5_LOGIN=12345678
MT5_PASSWORD=sua_senha
MT5_SERVER=NomeDaCorretora-Demo
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,EURJPY,GBPJPY
SYMBOL_SUFFIX=

# true = modo simulado: usa preços reais do MT5, registra tudo no diário e aprende,
# mas não envia ordens à corretora (recomendado até validar em conta demo)
DRY_RUN=true

# auto = abre sozinho e reporta | confirm = espera "SIM <id>"
EXECUTION_MODE=auto
# trava extra: em conta REAL com modo auto, só envia ordens se for true
ALLOW_REAL_AUTO=false

# ===== Aprendizado =====
LEARNING_ENABLED=true
LEARN_MIN_TRADES=20
LEARN_WINDOW=60
SYMBOL_MIN_TRADES=8
MAX_CONSEC_LOSSES=3

# ===== Relatórios =====
TIMEZONE=America/Sao_Paulo
DAILY_REPORT_HOUR=18

# ===== Risco =====
RISK_PER_TRADE=0.5
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=2.0
MAX_SPREAD_POINTS=30
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0

# ===== Sinais =====
SIGNAL_THRESHOLD=3.0
SIGNAL_EXPIRY_MIN=15
ANALYSIS_INTERVAL_MIN=15
NEWS_BLACKOUT_MIN=30
W_CALENDAR=1.0
W_NEWS=1.0
W_MACRO=1.0

# ===== Fontes =====
NEWS_FEEDS=https://www.fxstreet.com/rss/news
NEWS_LOOKBACK_HOURS=12
MACRO_FILE=macro.json

# ===== IA (sentimento de notícias) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== WhatsApp (Meta Cloud API) =====
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=uma_frase_secreta_qualquer
WA_APP_SECRET=
WA_API_VERSION=v21.0
# números autorizados a comandar (DDI+DDD+número, sem +), separados por vírgula
WA_ALLOWED_NUMBERS=5511999998888
WA_TEMPLATE_NAME=

# ===== Painel web =====
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_TOKEN=troque_por_um_token_longo_e_aleatorio
